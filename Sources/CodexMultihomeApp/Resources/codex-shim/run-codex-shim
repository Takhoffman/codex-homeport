#!/bin/sh
# Launcher for Codex Multihome's vendored codex-shim runtime.
set -eu

RESOURCE_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
RUNTIME_ROOT="${CODEX_MULTIHOME_SHIM_RUNTIME:-$HOME/Library/Application Support/CodexMultihome/codex-shim-runtime}"
VENV="$RUNTIME_ROOT/venv"
PYTHON="$VENV/bin/python"

if [ ! -x "$PYTHON" ]; then
    BOOTSTRAP_PYTHON="${CODEX_MULTIHOME_PYTHON:-python3}"
    if ! command -v "$BOOTSTRAP_PYTHON" >/dev/null 2>&1; then
        echo "Codex Multihome's bundled model-routing shim needs Python 3.11 or newer. Install Python 3.11+ and retry, or set a Shim executable override in Settings." >&2
        exit 1
    fi
    if ! "$BOOTSTRAP_PYTHON" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)'; then
        echo "Codex Multihome's bundled model-routing shim needs Python 3.11 or newer. Found: $($BOOTSTRAP_PYTHON --version 2>&1)" >&2
        exit 1
    fi
    mkdir -p "$RUNTIME_ROOT"
    if ! "$BOOTSTRAP_PYTHON" -m venv "$VENV"; then
        echo "Could not create the bundled shim virtual environment at $VENV." >&2
        exit 1
    fi
    if ! "$PYTHON" -m pip install --disable-pip-version-check --no-input --requirement "$RESOURCE_DIR/requirements.txt"; then
        rm -rf "$VENV"
        echo "Could not install the bundled shim dependencies. Check your network connection and retry, or set a Shim executable override in Settings." >&2
        exit 1
    fi
fi

exec "$PYTHON" -m codex_shim.cli "$@"
